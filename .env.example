# Copy this file to ".env" and fill in the values from your Supabase project:
# Supabase Dashboard → Project Settings → API (or "API Keys").
#
# Only the public URL and the publishable (anon) key belong here.
# NEVER put the service_role or any secret key in this file — everything
# prefixed with VITE_ is bundled into the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Python FastAPI backend that runs the Random Forest model (see backend/README.md).
VITE_API_BASE_URL=http://localhost:8000
